/**
 * 絵本出版イベント「くるくる」
 * フォーム自動返信スクリプト
 *
 * ════════════════════════════════════════
 *  初回セットアップ手順
 * ════════════════════════════════════════
 *  1. createKurukuruForm.gs を実行してフォームを作成する
 *  2. 実行ログに表示される「編集URL」を開く
 *  3. フォーム編集画面の上部メニュー「︙」→「Apps Script」を開く
 *     （これがフォームに紐づいた「コンテナバインド型スクリプト」になる）
 *  4. このファイルの中身を全選択して貼り付け、Cmd+S で保存
 *  5. 関数名を「setupTrigger」に選択して「▶ 実行」を押す
 *  6. Googleアカウントの許可画面が出たら「許可する」をクリック
 *  7. 「✅ 自動返信トリガーを設定しました」とログに出れば完了
 *
 * ════════════════════════════════════════
 *  顧客への譲渡後の再設定手順（顧客が行う）
 * ════════════════════════════════════════
 *  1. 譲渡されたフォームを開く
 *  2. 「︙」→「Apps Script」を開く
 *  3. 左メニューの「トリガー（時計アイコン）」をクリック
 *  4. 旧オーナーのトリガーを削除（ゴミ箱アイコン）
 *  5. 「＋ トリガーを追加」をクリック
 *  6. 下記の設定で追加する：
 *       実行する関数: sendAutoReply
 *       イベントのソース: フォームから
 *       イベントの種類: フォーム送信時
 *  7. 「保存」→ Googleアカウントの許可 → 完了
 */


// ════════════════════════════════════════
//  トリガー設定（初回のみ実行）
// ════════════════════════════════════════

function setupTrigger() {
  // 既存の自動返信トリガーを削除（重複防止）
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'sendAutoReply') {
      ScriptApp.deleteTrigger(triggers[i]);
      Logger.log('旧トリガーを削除しました');
    }
  }

  // フォームに紐づいたトリガーを新規作成
  var form = FormApp.getActiveForm();
  ScriptApp.newTrigger('sendAutoReply')
    .forForm(form)
    .onFormSubmit()
    .create();

  Logger.log('✅ 自動返信トリガーを設定しました');
  Logger.log('これよりフォーム送信のたびに自動返信メールが届きます。');
}


// ════════════════════════════════════════
//  自動返信メール本体（フォーム送信時に自動実行）
// ════════════════════════════════════════

function sendAutoReply(e) {
  var response = e.response;
  var itemResponses = response.getItemResponses();

  // 回答からお名前・メールアドレスを取得
  var recipientEmail = '';
  var recipientName  = '';

  for (var i = 0; i < itemResponses.length; i++) {
    var title = itemResponses[i].getItem().getTitle();
    var value = itemResponses[i].getResponse();

    if (title === 'メールアドレス') {
      recipientEmail = value;
    }
    if (title === 'お名前（フルネーム）') {
      recipientName = value;
    }
  }

  // メールアドレスが取得できない場合は終了
  if (!recipientEmail) {
    Logger.log('⚠️ メールアドレスが取得できませんでした。フォームの質問タイトルを確認してください。');
    return;
  }

  // ── メール内容 ──────────────────────────

  var subject = '【くるくる出版イベント】お申し込みありがとうございます';

  var body =
    recipientName + ' 様\n\n' +

    'この度は、\n' +
    '絵本出版イベント「くるくる」\n' +
    'スポット応援隊へご参加いただき、本当にありがとうございます。\n\n' +

    'この絵本「くるくる」は、\n' +
    'たくさんの人の応援や優しさに支えられて生まれました。\n\n' +

    '僕がこの絵本を通して伝えたいことは、\n' +
    '"目には見えない大切なもの"の存在です。\n\n' +

    '優しさ。\n' +
    '感謝。\n' +
    '誰かを想う気持ち。\n' +
    '「ありがとう」を伝えること。\n\n' +

    '本当に大切なものほど、\n' +
    'なぜか目には見えません。\n\n' +

    '今回の出版イベントも、\n' +
    'そんな想いを届けるための時間にしたいと思っています。\n\n' +

    '当日は、\n' +
    '応援してくださる皆さまの想いも背負って、しっかりお話しさせていただきます。\n\n' +

    '━━━━━━━━━━━━━━━\n' +
    '【お振込先】\n' +
    '福岡銀行\n' +
    '店番号：241\n' +
    '月隈支店\n' +
    '口座番号：0431288\n' +
    'マダ アツヒロ\n' +
    '━━━━━━━━━━━━━━━\n\n' +

    '【イベント詳細】\n\n' +
    '■ 日程\n' +
    '2026年8月29日（土）予定\n\n' +
    '■ 時間\n' +
    '開演 19:00\n' +
    '（終演予定 20:00）\n\n' +
    '■ 会場\n' +
    'ONE FUKUOKA BLDG.\n' +
    '「ワンビル」TSUTAYA 4階\n\n' +
    '■ 定員\n' +
    '100名\n\n' +
    '■ 参加費\n' +
    '1,500円（絵本付き）\n\n' +
    '※現在調整中のため、\n' +
    '日程・時間等が変更となる場合がございます。\n' +
    '変更がある場合は、改めてご連絡させていただきます。\n\n' +

    '━━━━━━━━━━━━━━━\n' +
    '【スポット応援隊 リターン】\n' +
    '・イベント当日ご招待\n' +
    '・サイン入り絵本プレゼント\n' +
    '・当日の衣装や会場へのお名前 / ロゴ掲載\n' +
    '・イベント映像データのお渡し\n\n' +

    '━━━━━━━━━━━━━━━\n' +
    '【サイン入り絵本について】\n\n' +
    '・当日ご参加の方\n' +
    '→ 会場にてお渡しいたします。\n\n' +
    '・ご来場が難しい方\n' +
    '→ 後日、郵送にてお届けいたします。\n\n' +

    '━━━━━━━━━━━━━━━\n\n' +

    'またイベント前にも、\n' +
    '改めてご連絡させていただきます。\n\n' +

    '本当にありがとうございます。\n\n' +

    '風のように、\n' +
    'みんなの想いをひとつに。\n\n' +

    '優しさや想いが、\n' +
    'くるくるのように巡っていく時間になりますように。\n\n' +

    '間田デザイン\n' +
    '間田 淳大\n';

  // ── 送信 ────────────────────────────────

  GmailApp.sendEmail(
    recipientEmail,
    subject,
    body,
    {
      name: '間田デザイン 間田 淳大',  // 送信者名（表示名）
      replyTo: 'atsuhiromada0327@gmail.com'
    }
  );

  Logger.log('✅ 自動返信送信完了 → ' + recipientEmail + '（' + recipientName + '）');
}
